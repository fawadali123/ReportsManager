@* One-off messages set by controllers through TempData. *@
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success rms-flash" role="status">
        <i class="bi bi-check-circle" aria-hidden="true"></i>
        <span>@success</span>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger rms-flash" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <span>@error</span>
    </div>
}
