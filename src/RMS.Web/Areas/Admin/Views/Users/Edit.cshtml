@model UserEditModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add user" : "Edit user";
}
<div class="rms-page-head">
    <div>
        <a class="rms-back" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Users</a>
        <h1>@(isNew ? "Add user" : $"Edit {Model.AdUsername}")</h1>
    </div>
</div>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? "" : Model.Id.ToString())" method="post" class="rms-panel rms-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" autofocus />
            <span asp-validation-for="Code" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AdUsername" class="form-label"></label>
            <input asp-for="AdUsername" class="form-control" autocapitalize="none" spellcheck="false" />
            <div class="form-text">The Windows sign-in name without the domain, for example <code>fawad.ali</code>.</div>
            <span asp-validation-for="AdUsername" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" />
            <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Role" class="form-label"></label>
            <select asp-for="Role" class="form-select">
                @foreach (var role in Roles.All)
                {
                    <option value="@role">@role</option>
                }
            </select>
            <div class="form-text">Admin takes effect only if the account is also in the admin group in Active Directory. Otherwise the person signs in as a viewer.</div>
            <span asp-validation-for="Role" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-md-6">
            <span class="form-label d-block">Status</span>
            <div class="form-check form-switch rms-switch">
                <input asp-for="Active" class="form-check-input" role="switch" />
                <label asp-for="Active" class="form-check-label">Active (can sign in)</label>
            </div>
        </div>
    </div>

    <div class="rms-form-actions">
        <button type="submit" class="btn btn-primary">@(isNew ? "Add user" : "Save changes")</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
        @if (!isNew)
        {
            <a class="btn btn-outline-secondary ms-auto" asp-controller="Assignments" asp-action="Index" asp-route-userId="@Model.Id">Assign reports</a>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScripts" />
}
