@model CategoryEditModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add category" : "Edit category";
}
<div class="rms-page-head">
    <div>
        <a class="rms-back" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Categories</a>
        <h1>@(isNew ? "Add category" : $"Edit {Model.Name}")</h1>
    </div>
</div>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? "" : Model.Id.ToString())" method="post" class="rms-panel rms-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" autofocus />
            <span asp-validation-for="Code" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
        </div>
        <div class="col-12">
            <div class="form-check form-switch rms-switch">
                <input asp-for="Active" class="form-check-input" role="switch" />
                <label asp-for="Active" class="form-check-label">Active (its reports are visible to viewers)</label>
            </div>
        </div>
    </div>

    <div class="rms-form-actions">
        <button type="submit" class="btn btn-primary">@(isNew ? "Add category" : "Save changes")</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScripts" />
}
