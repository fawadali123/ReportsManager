{
  "ConnectionStrings": {
    "RmsDb": "Data Source=.;Initial Catalog=RMS;User Id=sa;Password=Abcd@1234;TrustServerCertificate=True;",
    "RmsDb1": "Data Source=.;Initial Catalog=LIVEDB;User Id=sa;Password=Abcd@1234;TrustServerCertificate=True;",
    "RmsDb2": "Data Source=.;Initial Catalog=RMS;User Id=sa;Password=Abcd@1234;TrustServerCertificate=True;",
    "RmsDb3": "Data Source=.;Initial Catalog=RMS;User Id=sa;Password=Abcd@1234;TrustServerCertificate=True;"
  },

  "Database": {
    "Provider": "SqlServer",
    "ConnectionProviders": {}
  },

  "Authentication": {
    "Mode": "Development", //"Ldap",
    "SessionMinutes": 60,
    "Ldap": {
      "Server": "corp.example.com",
      "Port": 0,
      "UseSsl": false,
      "AuthType": "Negotiate",
      "Domain": "CORP",
      "UpnSuffix": "corp.example.com",
      "SearchBase": "DC=corp,DC=example,DC=com",
      "TimeoutSeconds": 15,
      "IgnoreCertificateErrors": false
    }
  },

  "Access": {
    "AdminGroup": "RMS_Admin",
    "UsersGroup": "RMS_Users"
  },

  "Reporting": {
    "DefaultConnectionName": "RmsDb",
    "MaxPreviewRows": 5000,
    "MaxExportRows": 100000,
    "MaxPdfRows": 10000,
    "CommandTimeoutSeconds": 120,
    "MaxLookupItems": 1000,
    "AllowStoredProcedures": true
  },

  // Shared with the RMS Scheduler service: keep these four the same in its appsettings.json.
  "Scheduling": {
    "DefaultTimeZone": "Arab Standard Time",
    "AllowedEmailDomains": [],
    "AllowedShareRoots": [],
    "MaxRecipients": 50,
    // Shown on the schedule screen; the service's own value is the one used.
    "RunAsUsername": "svc_rms_scheduler"
  },

  "Export": {
    "Pdf": {
      "License": "Community",
      "FontFamily": ""
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
