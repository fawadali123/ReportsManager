<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that touches the outside world: Oracle and SQL Server (plain ADO.NET),
    Active Directory (LDAP), the export file formats, and email and file-share delivery for schedules.
  -->
  <PropertyGroup>
    <RootNamespace>RMS.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives access to Microsoft.Extensions.* (options, logging, configuration, DI) without separate packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.7.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.1" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="QuestPDF" Version="2025.1.0" />
    <!-- Email for scheduled reports (SMTP). Microsoft Graph is called over plain HTTP, so it needs no package. -->
    <PackageReference Include="MailKit" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RMS.Core\RMS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RMS.Tests" />
  </ItemGroup>

</Project>
