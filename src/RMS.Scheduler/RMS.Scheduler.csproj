<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    RMS Scheduler: a Windows Service that runs scheduled reports and delivers them by email and/or to a
    shared folder. It uses the same report engine and database as the web application.
  -->
  <PropertyGroup>
    <RootNamespace>RMS.Scheduler</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>RMS.Scheduler</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RMS.Infrastructure\RMS.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <None Include="install-service.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
