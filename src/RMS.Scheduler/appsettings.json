{
  // Settings of the RMS Scheduler Windows service.
  //
  // Any value can be written as "env:VARIABLE_NAME" to read it from that environment variable instead,
  // which keeps passwords and connection strings out of this file. Set the variables as System variables
  // (the service does not see your user variables) and restart the service after changing them.

  // The same connections as the web application: RmsDb holds the RMS tables, the others are report connections.
  "ConnectionStrings": {
    "RmsDb": "User Id=RMS;Password=change-me;Data Source=//db-host:1521/ORCLPDB1"
  },

  "Database": {
    "Provider": "Oracle",
    "ConnectionProviders": {}
  },

  "Reporting": {
    "DefaultConnectionName": "RmsDb",
    "MaxExportRows": 100000,
    "MaxPdfRows": 10000,
    "CommandTimeoutSeconds": 600,
    "MaxLookupItems": 1000,
    "AllowStoredProcedures": true
  },

  "Export": {
    "Pdf": {
      "License": "Community",
      "FontFamily": ""
    }
  },

  // Keep DefaultTimeZone, AllowedEmailDomains, AllowedShareRoots and MaxRecipients the same as in the web application.
  "Scheduling": {
    "DefaultTimeZone": "",
    "AllowedEmailDomains": [],
    "AllowedShareRoots": [],
    "MaxRecipients": 50,

    // Name the reports run under: what @RMS_USERNAME holds and what the run history shows.
    // It does not have to be an RMS user or a Windows account.
    "RunAsUsername": "svc_rms_scheduler",
    "PollSeconds": 30,
    "MaxParallelRuns": 2,
    "RunTimeoutMinutes": 60
  },

  "Email": {
    // Smtp, Graph or None. Use Graph for Microsoft 365 when SMTP sign-in (SMTP AUTH) is switched off.
    "Provider": "None",
    "From": "reports@company.com",
    "FromName": "Reports Management",
    "MaxAttachmentMb": 10,

    "Smtp": {
      // Office 365: smtp.office365.com, 587, StartTls. Internal Exchange relay: the server name, 25, Auto, no username.
      "Host": "smtp.office365.com",
      "Port": 587,
      "Security": "StartTls",
      "Username": "reports@company.com",
      // Keep it out of this file with "env:RMS_SMTP_PASSWORD" (any variable name you like).
      "Password": "",
      "IgnoreCertificateErrors": false
    },

    "Graph": {
      // An Entra ID app registration with the Mail.Send application permission (admin consent granted).
      "TenantId": "",
      "ClientId": "",
      // For example "env:RMS_GRAPH_CLIENT_SECRET".
      "ClientSecret": "",
      "SenderMailbox": "",
      "SaveToSentItems": false
    }
  },

  "FileShare": {
    // Leave empty to write as the account the service runs under (recommended: give that account
    // Modify rights on the report folders). Otherwise DOMAIN\user and its password.
    "Username": "",
    "Password": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    }
  }
}
